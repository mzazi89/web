# ═══════════════════════════════════════════════════════════════
# MZAZI TECH — Environment Variables
# Copy to .env.local (never commit real values)
# ═══════════════════════════════════════════════════════════════

# ── Database (Neon PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# ── Site / Auth ───────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://mzazi.shop"
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_JWT_SECRET="change-me-admin-secret"
ADMIN_EMAIL="admin@mzazi.shop"
# Either a bcrypt hash or a plain password (see app/api/admin/login/route.js)
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD=""

# ── MZAZI API platform ────────────────────────────────────────
# Optional extra pepper mixed into API-key hashes
API_KEY_SECRET="change-me-api-key-pepper"

# Shared secret for the WhatsApp bot command registry (/api/bot-command).
# The bot sends this as `Authorization: Bearer <BOT_API_KEY>` to receive the
# full command payload (including handler code) + HMAC signature.
BOT_API_KEY="change-me-bot-api-key"

# Provider endpoints (server-side only — never exposed to the frontend)
# DavidCyril public API — the provider key is OPTIONAL (only sent if set).
# DAVIDCYRIL_API_URL defaults to the public API if unset; no key is needed.
DAVIDCYRIL_API_URL="https://apis.davidcyril.name.ng"
DAVIDCYRIL_API_KEY=""

# DrexApp (Trashcore) provider — keyless. Defaults to the live Heroku backend.
# The api.drexapp.space domain currently serves only the docs site; set this once
# your API domain is fixed.
DREXAPP_API_URL="https://apis-17ad50309099.herokuapp.com"
DREXAPP_API_KEY=""

# Provider response cache TTL in seconds (0 disables; default 60)
API_CACHE_TTL=60

# ── CORS (comma-separated origins, or * for all) ──────────────
ALLOWED_ORIGINS="https://mzazi.shop,https://www.mzazi.shop"

# ── Configurable rate limits (requests/day, -1 = unlimited) ───
# Overrides the values stored in the api_settings table
RATE_LIMIT_FREE_DAILY=100
RATE_LIMIT_PREMIUM_DAILY=10000
RATE_LIMIT_BUSINESS_DAILY=100000
RATE_LIMIT_ADMIN_DAILY=-1

# ── Third-party services used by the existing site ────────────
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PTERODACTYL_URL=""
PTERODACTYL_API_KEY=""

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
